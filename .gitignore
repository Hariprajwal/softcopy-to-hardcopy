# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Output artifacts & sample outputs (as requested)
*.png
*.jpg
*.jpeg
*.pdf
*.svg
*.gcode

# Pipeline directories - ignore all input, finished, and output contents except .gitkeep
pipeline/input/*
!pipeline/input/.gitkeep
pipeline/finished_input/*
!pipeline/finished_input/.gitkeep
pipeline/output/*
!pipeline/output/.gitkeep

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs & temp files
*.log
scratch/
